---
import DestinationLayout from '../../layouts/DestinationLayout.astro';
import { getCollection, render } from 'astro:content';
// Component imports
import ArticleImage from '../../components/ArticleImage.astro';

export async function getStaticPaths() {
  const destinations = await getCollection('destinationsCollection');

  return destinations.map(destination => ({
    params: { destination: destination.id }, 
    props: { destination },
  }));
}

const { destination } = Astro.props;
const { Content } = await render(destination);

const components = { ArticleImage }
---
<DestinationLayout destination={destination.data}>
  <Content components={components} />
</DestinationLayout>
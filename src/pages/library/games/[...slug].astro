---
import { getCollection, render } from 'astro:content';
import MediaPostLayout from '../../../layouts/MediaPostLayout.astro';
import type { CollectionEntry } from 'astro:content';
// Component imports
import ArticleImage from '../../../components/ArticleImage.astro';

export async function getStaticPaths() {
  const posts = await getCollection('gamesCollection');

  return posts.map((post, index) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

type Props = {
    post: CollectionEntry<'gamesCollection'>;
}

const { post } = Astro.props;
const { Content } = await render(post);

const components = { ArticleImage }
---
<MediaPostLayout frontmatter={post.data}>
  <Content components={components} />
</MediaPostLayout>